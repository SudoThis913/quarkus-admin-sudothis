{
  "realm": "sudothis",
  "enabled": true,

  "clients": [
    {
      "clientId": "sudothis-app",
      "publicClient": true,
      "redirectUris": ["http://localhost:8081/*"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "hd",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "hd",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "hd",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "admin@example.com",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@example.com",
      "firstName": "Site",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ],
      "realmRoles": ["admin"]
    }
  ],

  "roles": {
    "realm": [
      { "name": "admin", "description": "Full administrative access" },
      { "name": "user",  "description": "Standard user access" }
    ]
  },

  "identityProviders": [
    {
      "alias": "microsoft-entra",
      "displayName": "Microsoft Entra ID",
      "providerId": "oidc",
      "enabled": false,
      "trustEmail": true,
      "config": {
        "authorizationUrl": "https://login.microsoftonline.com/TENANT_ID/oauth2/v2.0/authorize",
        "tokenUrl": "https://login.microsoftonline.com/TENANT_ID/oauth2/v2.0/token",
        "jwksUrl": "https://login.microsoftonline.com/TENANT_ID/discovery/v2.0/keys",
        "issuer": "https://login.microsoftonline.com/TENANT_ID/v2.0",
        "clientId": "CONFIGURE_ENTRA_CLIENT_ID",
        "clientSecret": "CONFIGURE_ENTRA_CLIENT_SECRET",
        "defaultScope": "openid profile email GroupMember.Read.All",
        "validateSignature": "true",
        "useJwksUrl": "true"
      }
    },
    {
      "alias": "google-workspace",
      "displayName": "Google Workspace",
      "providerId": "google",
      "enabled": false,
      "trustEmail": true,
      "config": {
        "clientId": "CONFIGURE_GOOGLE_CLIENT_ID",
        "clientSecret": "CONFIGURE_GOOGLE_CLIENT_SECRET",
        "hostedDomain": "CONFIGURE_YOUR_DOMAIN.com",
        "defaultScope": "openid profile email"
      }
    }
  ],

  "identityProviderMappers": [
    {
      "name": "entra-groups-to-attribute",
      "identityProviderAlias": "microsoft-entra",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "groups",
        "user.attribute": "groups",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "entra-email",
      "identityProviderAlias": "microsoft-entra",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "email",
        "user.attribute": "email",
        "syncMode": "INHERIT"
      }
    },
    {
      "name": "google-hd-to-attribute",
      "identityProviderAlias": "google-workspace",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "hd",
        "user.attribute": "hd",
        "syncMode": "FORCE"
      }
    }
  ]
}
